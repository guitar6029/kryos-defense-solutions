# Select exactly one Neon environment: dev, staging, or production.
DB_ENV=dev

# Local Docker Compose settings. Use a URL-safe password for the Compose URLs.
POSTGRES_DB=kryos_dev
POSTGRES_USER=kryos
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
APP_PORT=3000

# Application/runtime pooled URL (not consumed by the current API).
DATABASE_URL_PRODUCTION=
# Direct URL used by Prisma CLI schema and migration commands.
DIRECT_URL_PRODUCTION=

# Staging pooled and direct URLs.
DATABASE_URL_STAGING=
DIRECT_URL_STAGING=

# Development pooled and direct URLs.
DATABASE_URL_DEV=
DIRECT_URL_DEV=
